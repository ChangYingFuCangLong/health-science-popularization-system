# ============================================================
# 复制为 .env 后必须修改（.env 已被 .gitignore 排除，不会入库）
#     cp .env.example .env
#
# 作用范围：本文件仅服务于 deploy/docker-compose.yml 的中间件容器。
#           后端应用的密钥（DEEPSEEK_API_KEY 等）不从这里读取，
#           应通过环境变量或 IDEA 运行配置注入。
# ============================================================

# MySQL root 密码 —— 必须修改
# 未建 .env 或该值为空时，容器会直接报错退出
# （compose 使用 ${VAR:?} 强制校验）。这是有意设计：
# 弱口令静默生效，比显式失败危险得多。
MYSQL_ROOT_PASSWORD=CHANGE_ME

# MySQL 宿主机端口映射
# 冲突风险：若 Windows 侧装有 MySQL 8.0 服务且为「自动」启动，
#   某次重启后它会先占用 3306，容器将报 "bind: address already in use"
#   —— 该报错极易被误判为 compose 配置问题。
# 建议：到 services.msc 将 MySQL 服务改为「手动」，或把本值改为 3307。
MYSQL_PORT=3306

# Redis 宿主机端口映射
# 冲突风险：若已有其他 Redis 容器占用 6379，本编排的 redis 服务会启动失败。
# 起步阶段可只启 MySQL：docker compose up -d mysql
REDIS_PORT=6379

# ============================================================
# PostgreSQL（v2.0 主存储，docs/V2/04 §一 Q1 批准）
# ============================================================

# PostgreSQL postgres 用户密码 —— 必须修改
# 未建 .env 或该值为空时，postgres 服务会直接报错退出（compose ${VAR:?} 强制校验）
PG_PASSWORD=CHANGE_ME

# PostgreSQL 宿主机端口映射
# 冲突风险：若本机已有其他 PostgreSQL 实例占用 5432，改本值（如 5433），
#   或停掉冲突容器——⛔ 只停不删：docker stop <冲突容器名>
PG_PORT=5432
